# Copy to .env.local for local dev, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# --- Server-only secrets (used by /api/* route handlers, never shipped to the browser) ---
LASTFM_API_KEY=
LASTFM_USERNAME=acanto7
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-3.5-turbo-0125

# --- Public browser key for the 3D map ---
# Google Maps keys are visible by design: restrict this one by HTTP referrer
# (acanto7.vercel.app/*, localhost:3000/*) in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Optional ---
NEXT_PUBLIC_DISCORD_USER_ID=760451623474036766
